# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it's already in .gitignore.

# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# New-signup admin notification (see README "New-signup notifications").
# From resend.com -> API Keys. Leave unset to disable the notification
# entirely (signups still work fine; you just won't be emailed about them).
RESEND_API_KEY=your-resend-api-key
# Where the one-time "new account" email is sent.
ADMIN_NOTIFY_EMAIL=you@example.com
# Optional: defaults to Resend's no-setup-required test sender, which can
# send to any address without verifying your own domain first.
RESEND_FROM_EMAIL=Lumen <onboarding@resend.dev>
